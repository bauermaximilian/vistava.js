{
  "include": [
    "src/**/*", 
    "examples/**/*"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "checkJs": true,
    
    "strict":true,
    "alwaysStrict":true,

    "noImplicitAny":false,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals":true,

    "noUnusedParameters":null,
    "noImplicitOverride": null,
    "noUncheckedIndexedAccess":null,
  }
}